{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio",
  "version": "1.0.0",
  "identifier": "com.folio.reader",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "Folio — Markdown Reader",
      "width": 1180,
      "height": 820,
      "minWidth": 620,
      "minHeight": 480,
      "backgroundColor": "#faf9f6",
      "dragDropEnabled": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": { "active": false }
}
